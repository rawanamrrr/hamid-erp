# Copy to .env and set real values in production. Never commit the real .env.
# Loaded via the environment (systemd EnvironmentFile, docker env, or the shell).

# --- Core ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=mekawyerp.shop,www.mekawyerp.shop,167.86.71.246
DJANGO_CSRF_TRUSTED_ORIGINS=https://mekawyerp.shop,https://www.mekawyerp.shop

# --- HTTPS hardening (only read when DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# --- Database: leave as sqlite for dev, switch to postgres for production ---
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_ENGINE=postgres
# DJANGO_DB_NAME=wholesale_pos
# DJANGO_DB_USER=pos_user
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- Email (move the Gmail app password out of the DB / SystemSetting) ---
# DJANGO_GMAIL_SENDER=
# DJANGO_GMAIL_APP_PASSWORD=
